{#-
  report_appendix.html.j2 -- the standalone model-input appendix, downloaded
  separately from the report itself (report.py: download_report_appendix_pdf).

  This intentionally shares report.css with report.html.j2 so the two
  documents look like companion pieces, but it is its own document: it is not
  stored with the report and is rebuilt from disk on every download.
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ report.title }} -- model input data</title>
  {# Both stylesheets are our own static assets, never user input, so they are
     emitted raw; autoescaping would turn the quotes into entities that CSS
     does not decode. #}
  <style>{{ fonts | safe }}</style>
  <style>{{ css | safe }}</style>
</head>
<body>

<section class="cover">
  <div class="cover-eyebrow">WaterPath scenario report -- appendix</div>
  <h1 class="cover-title">{{ report.title }}</h1>
  <p class="cover-subtitle">Model input data</p>

  <dl class="cover-meta">
    <dt>Case study</dt>
    <dd>{{ case_study.name }}</dd>
    <dt>Scenarios</dt>
    <dd>
      {% for scenario in appendix_scenarios %}
      {{ scenario.name }}{% if scenario.year %} ({{ scenario.year }}){% endif %}{% if not loop.last %},{% endif %}
      {% endfor %}
    </dd>
    <dt>Generated</dt>
    <dd>{{ generated_on }}</dd>
  </dl>
</section>

{% if toc %}
<nav class="toc-page">
  <h2 class="chapter-heading">
    <span class="chapter-kicker">Contents</span>
    Table of contents
  </h2>
  <ol class="toc">
    {% for entry in toc %}
    <li class="toc-entry toc-level-{{ entry.level }}">
      <a href="#{{ entry.anchor }}"><span class="toc-label">{{ entry.title }}</span></a>
    </li>
    {% endfor %}
  </ol>
</nav>
{% endif %}

<section class="section section-intro">
  {{ intro_html | safe }}
</section>

<section class="appendix-page">
  {% for scenario in appendix_scenarios %}
  <h3 id="{{ scenario.anchor }}" class="appendix-scenario">
    {{ scenario.name }}{% if scenario.year %} ({{ scenario.year }}{% if scenario.ssp %}, {{ scenario.ssp }}{% endif %}){% elif scenario.ssp %} ({{ scenario.ssp }}){% endif %}
  </h3>
  {% for group in scenario.groups %}
  <h4 class="appendix-driver">{{ group.driver }}</h4>
  {% for raw in group.tables %}
  {% if raw.note %}<p class="appendix-note">{{ raw.note }}</p>{% endif %}
  <p class="appendix-source">{{ raw.title }}</p>
  <table class="appendix-table">
    <thead>
      <tr>
        <th class="col-metric">{{ raw.label_column }}</th>
        {% for column in raw.columns %}
        <th>{{ column }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in raw.rows %}
      <tr>
        <td class="metric-label">{{ row.label }}</td>
        {% for value in row.cells %}
        <td class="value-cell">{{ value }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if raw.truncated %}
  <p class="appendix-note">Showing the first {{ raw.rows | length }} of {{ raw.total_rows }} rows.</p>
  {% endif %}
  {% endfor %}
  {% endfor %}
  {% endfor %}
</section>

</body>
</html>
