# ── backend stage ─────────────────────────────────────────────────────────
FROM python:3.9-slim AS backend

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libgdal-dev \
    gdal-bin \
    libcairo2 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000

CMD ["python", "-m", "flask", "--app", "backend/app.py", "run", "--host=0.0.0.0", "--port=5000", "--debug"]

# ── frontend stage ────────────────────────────────────────────────────────
FROM node:18-alpine AS frontend

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install

EXPOSE 3000

CMD ["npm", "run", "dev"]
